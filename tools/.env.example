# Copy to .env and fill in, or just export these in your shell.

# Required. From https://developer.hypixel.net/dashboard
HYPIXEL_API_KEY=

# Optional. Discord webhook for window notifications.
DISCORD_WEBHOOK=

# Where the mod reads commands from. Windows default below.
# BRIDGE_FILE=%APPDATA%\.minecraft\config\snipe_cmd.txt

# Poll interval. 4 is the sweet spot; below 3 buys nothing.
POLL_SECONDS=4
